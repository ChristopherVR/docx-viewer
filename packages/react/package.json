{
	"name": "@christophervr/docx-react-viewer",
	"version": "0.1.0",
	"description": "React component for the DOCX editor. Self-contained: includes the editor, layout engine and legacy .doc reader.",
	"keywords": [
		"doc",
		"docx",
		"editor",
		"react",
		"word"
	],
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/docx-viewer.git",
		"directory": "packages/react"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@christophervr/docx-core": "^0.1.0",
		"@christophervr/ooxml-core": "^0.2.0",
		"prosemirror-collab": "^1.3.1",
		"prosemirror-commands": "^1.7.1",
		"prosemirror-history": "^1.4.1",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.0",
		"prosemirror-state": "^1.4.3",
		"prosemirror-transform": "^1.10.5",
		"prosemirror-view": "^1.40.0"
	},
	"peerDependencies": {
		"react": ">=18"
	}
}
